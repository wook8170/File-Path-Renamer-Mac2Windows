{
  "name": "file-path-renamer",
  "productName": "File-Path-Renamer",
  "version": "0.1.0",
  "private": true,
  "description": "A local macOS Tauri app that normalizes filenames from NFD to NFC for Outlook attachments.",
  "scripts": {
    "dev:web": "vite",
    "dev": "sh -c '. \"$HOME/.cargo/env\" && tauri dev'",
    "build:web": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:build": "sh -c '. \"$HOME/.cargo/env\" && tauri build'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^6.3.5"
  }
}
